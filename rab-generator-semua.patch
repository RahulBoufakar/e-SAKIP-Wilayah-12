diff --git a/tests/Feature/RabGenerator/CleanupTempReportsTest.php b/tests/Feature/RabGenerator/CleanupTempReportsTest.php
new file mode 100644
index 0000000..906b310
--- /dev/null
+++ b/tests/Feature/RabGenerator/CleanupTempReportsTest.php
@@ -0,0 +1,62 @@
+<?php
+
+use Illuminate\Console\Scheduling\Schedule;
+use Illuminate\Support\Facades\Artisan;
+use Illuminate\Support\Facades\Storage;
+
+/** Buat berkas di disk private lalu atur umurnya (menit yang lalu). */
+function tempRab(string $path, int $umurMenit): void
+{
+    Storage::disk('private')->put($path, 'x');
+    touch(Storage::disk('private')->path($path), time() - $umurMenit * 60);
+}
+
+beforeEach(function () {
+    Storage::fake('private');
+});
+
+it('S6: berkas temp lebih dari 1 jam dihapus, yang lebih baru tidak', function () {
+    tempRab('temp/lama.xlsx', 61);
+    tempRab('temp/baru.xlsx', 59);
+    tempRab('temp/sangat-baru.xlsx', 1);
+
+    $this->artisan('rab-generator:cleanup-temp')->expectsOutput('Selesai. Berkas temp dihapus: 1.')->assertSuccessful();
+
+    Storage::disk('private')->assertMissing('temp/lama.xlsx');
+    Storage::disk('private')->assertExists('temp/baru.xlsx');
+    Storage::disk('private')->assertExists('temp/sangat-baru.xlsx');
+});
+
+it('hanya menyentuh temp/*.xlsx: berkas lain dan folder lain dibiarkan walau tua', function () {
+    tempRab('temp/catatan.txt', 600);
+    tempRab('rab-master/master.xlsx', 600);
+    tempRab('temp/lama.xlsx', 600);
+
+    $this->artisan('rab-generator:cleanup-temp')->assertSuccessful();
+
+    Storage::disk('private')->assertExists('temp/catatan.txt');
+    Storage::disk('private')->assertExists('rab-master/master.xlsx');
+    Storage::disk('private')->assertMissing('temp/lama.xlsx');
+});
+
+it('batas dapat diubah lewat --menit', function () {
+    tempRab('temp/sepuluh-menit.xlsx', 10);
+
+    $this->artisan('rab-generator:cleanup-temp', ['--menit' => 5])->assertSuccessful();
+
+    Storage::disk('private')->assertMissing('temp/sepuluh-menit.xlsx');
+});
+
+it('aman dijalankan bila folder temp belum ada', function () {
+    $this->artisan('rab-generator:cleanup-temp')->expectsOutput('Selesai. Berkas temp dihapus: 0.')->assertSuccessful();
+});
+
+it('terdaftar di scheduler tiap 15 menit', function () {
+    Artisan::call('list'); // bootstrap kernel konsol supaya Kernel::schedule() dijalankan
+
+    $event = collect(app(Schedule::class)->events())
+        ->first(fn ($e) => str_contains($e->command, 'rab-generator:cleanup-temp'));
+
+    expect($event)->not->toBeNull()
+        ->and($event->expression)->toBe('*/15 * * * *');
+});
diff --git a/tests/Feature/RabGenerator/PengaturanTemplateTest.php b/tests/Feature/RabGenerator/PengaturanTemplateTest.php
new file mode 100644
index 0000000..3d8d072
--- /dev/null
+++ b/tests/Feature/RabGenerator/PengaturanTemplateTest.php
@@ -0,0 +1,237 @@
+<?php
+
+use App\Events\ActivityOccurred;
+use App\Models\FileExcel;
+use App\Models\TemplateDokumen;
+use Illuminate\Http\UploadedFile;
+use Illuminate\Support\Facades\Event;
+use Illuminate\Support\Facades\Storage;
+
+/*
+ * Tab "Template Dokumen" di Pengaturan (08 langkah 12 butir 3): kartu unggah rab_excel lama disembunyikan
+ * dan rab_pdf lama disembunyikan begitu RAB Generator menggantikannya, diganti kartu yang mengarah ke halaman
+ * file master. Berkas lama boleh dihapus admin (dicatat di log). Template KAK/TOR tidak berubah.
+ */
+
+function halamanTemplate($test)
+{
+    return $test->actingAs($test->admin)->get(route('admin.pengaturan.index', ['tab' => 'template']));
+}
+
+function aksiUnggah(string $kode): string
+{
+    return 'action="'.route('admin.pengaturan.template.update', $kode).'"';
+}
+
+beforeEach(function () {
+    $this->admin = userWithRole('admin');
+
+    foreach (['rab_excel' => 'Template RAB (Excel)', 'rab_pdf' => 'Template RAB (PDF)', 'kak_tor' => 'Template KAK/TOR (Word)'] as $kode => $nama) {
+        TemplateDokumen::create(['kode' => $kode, 'nama' => $nama]);
+    }
+});
+
+it('flag mati: tampilan lama utuh, kartu rab_excel masih ada dan tidak ada tombol generator', function () {
+    config(['rab_generator.enabled' => false]);
+
+    halamanTemplate($this)->assertOk()
+        ->assertSee(aksiUnggah('rab_excel'), false)
+        ->assertSee(aksiUnggah('rab_pdf'), false)
+        ->assertSee(aksiUnggah('kak_tor'), false)
+        ->assertDontSee('Kelola File Master RAB');
+});
+
+it('flag aktif tanpa master aktif: tombol ke generator tampil dengan peringatan, kartu rab_excel lama tetap ada', function () {
+    config(['rab_generator.enabled' => true]);
+
+    halamanTemplate($this)->assertOk()
+        ->assertSee('Kelola File Master RAB')
+        ->assertSee(route('admin.rab-generator.index'), false)
+        ->assertSee('Belum ada file master aktif')
+        ->assertSee(aksiUnggah('rab_excel'), false) // template lama masih satu-satunya yang dipakai tim kerja
+        ->assertSee(aksiUnggah('rab_pdf'), false);
+});
+
+it('flag aktif dengan master aktif: kartu rab_excel dan rab_pdf lama disembunyikan, KAK/TOR tetap, master aktif ditampilkan', function () {
+    config(['rab_generator.enabled' => true]);
+    FileExcel::create(['nama_file' => 'master-rab-2026.xlsx', 'path' => 'rab-master/x.xlsx', 'hash_sha256' => str_repeat('a', 64)])->aktifkan();
+
+    halamanTemplate($this)->assertOk()
+        ->assertSee('Kelola File Master RAB')
+        ->assertSee('File master aktif')
+        ->assertSee('master-rab-2026.xlsx')
+        ->assertDontSee(aksiUnggah('rab_excel'), false)
